SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=change-me
SMTP_FROM=STROS obedovy system <noreply@example.com>
ORDER_EMAIL_TO=jidelny@example.com
# Veřejná adresa aplikace. Používá se pro odkazy v e-mailech, pozvací odkazy
# a návratovou adresu Googlu. Nikdy se nebere z hlavičky Host — tu si útočník
# nastaví sám a odkaz by mířil k němu i s platným tokenem.
APP_URL=https://obedy.example.com

# Podpisový klíč pro krátkodobé OAuth cookies. Samostatný, nikdy odvozený
# z GOOGLE_CLIENT_SECRET. Nejméně 32 bajtů.
# Vygenerujte například příkazem: openssl rand -base64 32
COOKIE_SIGNING_SECRET=

# První správce. Založí se při migraci, a jen když žádný správce neexistuje —
# změněné heslo už nikdy nepřepíše. Dokud žádný správce není, chová se
# aplikace jako před účty a zápisy nezamyká.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google přihlášení (volitelné). Hodnoty v Nastavení mají přednost.
# U Googlu zaregistrujte návratovou adresu <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
